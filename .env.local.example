# AboutTrain — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it is already in .gitignore.

# ─── SUPABASE ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → project → Settings → API

# Public URL — safe to expose to browser (protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key — safe to expose to browser (protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service-role key — NEVER expose to browser or client components.
# Used only for server-side admin operations (data seeding, migrations).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── APP ──────────────────────────────────────────────────────────────────────
# Used for auth callback redirect URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── DEMO MODE ────────────────────────────────────────────────────────────────
# If NEXT_PUBLIC_SUPABASE_URL is not set, the app runs in demo mode with
# mock data. No Supabase connection is attempted.
# To force demo mode even with env vars set, comment out the SUPABASE lines above.

# ─── SECRETS ──────────────────────────────────────────────────────────────────
INGESTION_SECRET=
